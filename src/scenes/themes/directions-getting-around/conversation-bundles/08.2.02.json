              "rewards": [
                {
                  "type": "stat",
                  "stat": "speaking",
                  "amount": 3
                }
              ]
            },
            {
              "id": "turn-03-choice-02",
              "text": "Do I need to walk around the building?",
              "feedback": {
                "naturalness": 5,
                "assessment": "自然、符合当前情景",
                "naturalExpression": "Do I need to walk around the building?",
                "explanation": "“Do I need”问的是有没有必要或是否必须，帮助分清必做步骤与可选做法。"
              },
              "rewards": [
                {
                  "type": "stat",
                  "stat": "speaking",
                  "amount": 3
                }
              ]
            },
            {
              "id": "turn-03-choice-03",
              "text": "Is there another entrance nearby?",
