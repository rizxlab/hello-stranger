        {
          "id": "partner",
          "name": "工作人员",
          "role": "partner"
        }
      ],
      "turns": [
        {
          "id": "turn-01",
          "type": "line",
          "speakerId": "player",
          "text": "Excuse me, I’m trying to get into the museum, but I can’t find the entrance."
        },
        {
          "id": "turn-02",
          "type": "line",
          "speakerId": "partner",
          "text": "The main entrance is on the other side of the building."
        },
        {
          "id": "turn-03",
          "type": "choice",
          "speakerId": "player",
          "prompt": "你想确认位置或前往的路线，会怎么问？",
          "choices": [
            {
              "id": "turn-03-choice-01",
              "text": "How do I get there from here?",
              "feedback": {
                "naturalness": 5,
                "assessment": "自然、符合当前情景",
                "naturalExpression": "How do I get there from here?",
                "explanation": "“how do I get”询问到达方法，方便对方提供路线或交通方式。"
