        },
        {
          "id": "partner",
          "name": "Landlord",
          "role": "partner"
        }
      ],
      "turns": [
        {
          "id": "turn-01",
          "type": "line",
          "speakerId": "player",
          "text": "Hi, I wanted to ask about a noise problem."
        },
