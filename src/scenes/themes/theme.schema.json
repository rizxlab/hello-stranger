{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hello-stranger.local/schemas/theme.schema.json",
  "title": "Hello Stranger Theme Category",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "catalogNumber",
    "title",
    "eyebrow",
    "order"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "catalogNumber": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "eyebrow": { "type": "string", "minLength": 1 },
    "experienceLabel": { "type": "string", "minLength": 1 },
    "cover": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 }
  }
}
