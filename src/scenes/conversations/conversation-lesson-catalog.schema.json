{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hello-stranger.local/schemas/conversation-lesson-catalog.schema.json",
  "title": "Conversation Lesson Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["seriesId", "lessons"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "seriesId": { "type": "string", "minLength": 1 },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number", "title", "setting", "partnerName", "opening", "prompt",
          "natural", "alternative", "awkward", "response", "tip", "vocabulary"
        ],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "cover": { "type": "string", "minLength": 1 },
          "setting": { "type": "string", "minLength": 1 },
          "partnerName": { "type": "string", "minLength": 1 },
          "opening": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "natural": { "type": "string", "minLength": 1 },
          "alternative": { "type": "string", "minLength": 1 },
          "awkward": { "type": "string", "minLength": 1 },
          "response": { "type": "string", "minLength": 1 },
          "tip": { "type": "string", "minLength": 1 },
          "vocabulary": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
