{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hello-stranger.local/schemas/story.schema.json",
  "title": "Hello Stranger Story Chapter",
  "description": "Hello Stranger 单章节剧情数据格式。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "storyId",
    "title",
    "chapterNumber",
    "startSceneId",
    "startNodeId",
    "scenes",
    "characters",
    "nodes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "storyId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "chapterNumber": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "startSceneId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "startNodeId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "englishSkill": {
      "enum": ["speaking", "listening", "reading", "vocabulary"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "$ref": "#/$defs/position"
        },
        "portrait": {
          "$ref": "#/$defs/position"
        },
        "landscape": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "interaction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetId"],
          "properties": {
            "type": {
              "const": "dialogue"
            },
            "targetId": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "sceneActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "characterId", "label", "placement", "interaction"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "characterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "background", "objective", "actors"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "background": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "objective": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sceneActor"
          }
        },
        "nextSceneId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "avatar": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speakerId", "text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "speakerId": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "translation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audio": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stat", "value"],
          "properties": {
            "type": {
              "const": "minimumStat"
            },
            "stat": {
              "$ref": "#/$defs/englishSkill"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "word"],
          "properties": {
            "type": {
              "const": "hasVocabulary"
            },
            "word": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "characterId", "value"],
          "properties": {
            "type": {
              "const": "minimumRelationship"
            },
            "characterId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "flag", "value"],
          "properties": {
            "type": {
              "const": "flag"
            },
            "flag": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "reward": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stat", "amount"],
          "properties": {
            "type": {
              "const": "stat"
            },
            "stat": {
              "$ref": "#/$defs/englishSkill"
            },
            "amount": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "words"],
          "properties": {
            "type": {
              "const": "vocabulary"
            },
            "words": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "characterId", "amount"],
          "properties": {
            "type": {
              "const": "relationship"
            },
            "characterId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "amount": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "flag", "value"],
          "properties": {
            "type": {
              "const": "flag"
            },
            "flag": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naturalness", "assessment", "explanation"],
      "properties": {
        "naturalness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "assessment": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "naturalExpression": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "feedback", "nextNodeId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        },
        "nextNodeId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "background", "dialogue"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "background": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dialogueLine"
          }
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "nextNodeId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["choices", "nextNodeId"]
          }
        }
      ]
    }
  }
}
